{
  "name": "gastador",
  "version": "2.0.0",
  "private": true,
  "description": "Gastador: local-first student allowance tracker",
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "test": "npm --prefix client test && npm --prefix server test",
    "typecheck": "npm --prefix client run typecheck",
    "migrate": "npm --prefix server run migrate",
    "dev:server": "npm --prefix server run dev",
    "start": "npm --prefix server start"
  }
}
