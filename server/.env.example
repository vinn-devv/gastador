# PostgreSQL connection string. Create the database before running migrations.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gastador
# Use true only when your PostgreSQL provider requires TLS.
DATABASE_SSL=false
# Keep this true for local development. Production HTTPS should set NODE_ENV=production.
NODE_ENV=development
PORT=4000
SESSION_DAYS=30

PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT_JSON=
